# ─── Resend ─────────────────────────────────────────────
# Chave de API do Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail de onde as notificações saem (precisa estar verificado no Resend)
FROM_EMAIL=noreply@champion.ind.br

# E-mail que recebe as notificações de novos contatos
NOTIFICATION_EMAIL=contato@champion.ind.br

# ─── Firebase Admin SDK ───────────────────────────────────
# Cole aqui o JSON inteiro do service account do Firebase, em uma linha.
# Gere em: Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# ID do projeto Firebase (mesmo do firebase-config.js)
FIREBASE_PROJECT_ID=seu-projeto-id

# --- Google Drive / Downloads -----------------------------------------------
# Habilite a Google Drive API no projeto da conta de servico e compartilhe a
# pasta que sera a raiz do painel com o e-mail da service account (Leitor).
# Pode ser apenas o ID ou a URL completa da pasta. O backend impede navegacao e
# download de itens fora dessa arvore.
GOOGLE_DRIVE_ROOT_FOLDER_ID=cole-o-id-ou-url-da-pasta-raiz

# Opcao recomendada: credencial exclusiva do Drive, em JSON (uma linha) ou o
# mesmo JSON codificado em base64. Se omitida, o backend reutiliza a service
# account FIREBASE_SERVICE_ACCOUNT / FIREBASE_CLIENT_EMAIL automaticamente.
GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Alternativa ao JSON acima:
# GOOGLE_DRIVE_PROJECT_ID=seu-projeto-google
# GOOGLE_DRIVE_CLIENT_EMAIL=service-account@seu-projeto.iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opcional e somente para Google Workspace com delegacao em todo o dominio:
# GOOGLE_DRIVE_IMPERSONATE_USER=usuario@champion.ind.br

# Protecoes para publicacao recursiva e busca publica (valores padrao abaixo):
# GOOGLE_DRIVE_IMPORT_MAX_FILES=1000
# GOOGLE_DRIVE_IMPORT_MAX_DEPTH=25
# GOOGLE_DRIVE_IMPORT_MAX_ITEMS=5000
# GOOGLE_DRIVE_API_TIMEOUT_MS=20000
# GOOGLE_DRIVE_STREAM_TIMEOUT_MS=300000
# PUBLIC_DOWNLOADS_SCAN_LIMIT=5000
# PUBLIC_DOWNLOADS_CACHE_MS=30000

# ─── Agente de atendimento (LLM) ──────────────────────────
# ESTA É A ÚNICA VARIÁVEL OBRIGATÓRIA DO CHAT.
# Chave da API do modelo. NUNCA vai para o frontend — o site é estático e
# qualquer pessoa leria a chave pelo DevTools. Fica só aqui.
# Se esta chave já apareceu em algum lugar (chat, print, commit), revogue e
# gere outra: chave exposta é chave queimada.
LLM_API_KEY=cole-a-chave-aqui

# ─── Opcionais: só declare se for mudar o padrão ──────────
# Tudo abaixo já tem o valor certo embutido no código. Estas linhas existem
# para você poder trocar sem precisar editar e redeployar o backend.

# Provedor. O formato é o da OpenAI, então trocar de modelo é trocar estas
# duas linhas — o código não muda.
#   Padrão: https://api.deepseek.com + deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Shopify Storefront — fonte do catálogo do agente. O padrão é o mesmo valor
# de frontend/js/shopify-config.js. Só preencha se a loja mudar.
# SHOPIFY_DOMAIN=sua-loja.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=cole-o-token-storefront
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_METAFIELD_NAMESPACE=custom

# URL pública do site — usada para montar o link da página do produto
# SITE_URL=https://champion.ind.br

# ─── CORS ────────────────────────────────────────────────
# Lista de origens permitidas, separadas por vírgula (sem barra final)
# Inclua o domínio da Hostinger e localhost para dev
ALLOWED_ORIGINS=https://champion.ind.br,https://www.champion.ind.br,http://localhost:5500,http://127.0.0.1:5500

# ─── Servidor ────────────────────────────────────────────
# Railway define PORT automaticamente; defina aqui só para desenvolvimento local
PORT=3000
