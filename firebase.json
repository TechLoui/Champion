{
  "functions": {
    "source": "functions",
    "predeploy": [
      "node -e \"require('fs').copyFileSync('frontend/produto.html','functions/produto-template.html')\""
    ]
  },
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/sitemap.xml", "function": { "functionId": "sitemap", "region": "us-central1" } },
      { "source": "/api/**", "destination": "/" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=604800" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
